# X Bookmarks Scraper Configuration
# Copy this file to .env and customize as needed

# Chrome profile directory (where login cookies are stored)
# PROFILE_DIR=./x-profile

# Run browser in headless mode (true/false)
# HEADLESS=false

# Maximum number of scrolls before stopping
# MAX_SCROLLS=1000

# Delay between scrolls in milliseconds
# SCROLL_DELAY=1000

# Number of scrolls with no growth before stopping
# NO_GROWTH_THRESHOLD=6
