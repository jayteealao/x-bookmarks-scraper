{
  "name": "x-bookmarks-scraper",
  "version": "1.0.0",
  "description": "Local exporter for X (Twitter) Bookmarks using Playwright",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "discover": "tsx src/index.ts --mode=discover",
    "extract": "tsx src/index.ts --mode=extract",
    "verify": "tsx src/verify-har.ts",
    "build": "tsc",
    "dev": "tsx src/index.ts"
  },
  "keywords": ["twitter", "bookmarks", "scraper", "playwright"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "@playwright/test": "^1.40.1",
    "playwright": "^1.40.1"
  }
}
